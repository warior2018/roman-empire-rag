# Copy this file to .env and fill in your real key. Never commit .env!

# AI that writes the answers (Gemini, OpenAI-compatible API)
OPENAI_API_KEY=your-gemini-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-flash-lite-latest

# Optional experiments (defaults shown)
# CHUNK_WORDS=160
# OVERLAP_WORDS=25
# TOP_K=5
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2
